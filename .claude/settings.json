{
  "metadata": {
    "tool": "Claude Code CLI",
    "version": "2.0",
    "description": "Claude Code workspace configuration. hooks.PreToolUse is advisory-only (issue #354): it reports, it never blocks a commit. Graph tooling (issue #360) is code-review-graph + graphify, replacing the better-code-review-graph fork from #357.",
    "lastUpdated": "2026-09-07",
    "effortLevel": "medium"
  },
  "pathScopes": {
    "frontend": {
      "pattern": "frontend/**",
      "model": "claude-sonnet-5",
      "reasoning": "enabled",
      "description": "React components, UI logic, accessibility",
      "timeout": 180
    },
    "backend-graphql": {
      "pattern": "backend-graphql/**",
      "model": "claude-sonnet-5",
      "reasoning": "enabled",
      "description": "GraphQL resolvers, DataLoader, Prisma queries",
      "timeout": 180
    },
    "backend-express": {
      "pattern": "backend-express/**",
      "model": "claude-sonnet-5",
      "reasoning": "disabled",
      "description": "Express routes, webhooks, SSE handlers",
      "timeout": 120
    },
    "tests": {
      "pattern": "**/*.test.ts",
      "model": "claude-sonnet-5",
      "reasoning": "enabled",
      "description": "Test writing and validation",
      "timeout": 180
    },
    "docs": {
      "pattern": "docs/**",
      "model": "claude-haiku-4-5-20251001",
      "description": "Documentation files (use base model)"
    }
  },
  "reasoning": {
    "enabled": false,
    "budget_tokens": 5000
  },
  "performance": {
    "fastMode": true,
    "maxInputTokens": 180000,
    "maxOutputTokens": 16000,
    "timeout": 180
  },
  "tokenBudget": {
    "maxPerRequest": 180000,
    "costTarget": "optimized",
    "cacheStrategy": "aggressive",
    "promptCacheTTL": 3600
  },
  "caching": {
    "enabled": true,
    "ttl": 3600,
    "strategy": "aggressive-with-prompt-cache",
    "description": "Prompt caching on CLAUDE.md + settings.json base = 90% cache hit for repeat sessions"
  },
  "telemetry": {
    "enabled": true,
    "analytics": "minimal",
    "errorReporting": true
  },
  "skills": {
    "autoLoad": [
      "caveman:cavecrew-builder",
      "caveman:cavecrew-investigator",
      "code-review",
      "simplify"
    ],
    "contextual": {
      "frontend/**": ["example-skills:frontend-design", "dataviz"],
      "backend-graphql/**": ["artifact-design"],
      "docs/**": ["artifact-design", "example-skills:doc-coauthoring"]
    }
  },
  "permissions": {
    "scope": "Claude Code CLI (local development only)",
    "allow": [
      "Bash(pnpm *)",
      "Bash(git *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(wc *)",
      "Bash(docker *)",
      "Bash(curl *)",
      "Read(CLAUDE.md)",
      "Read(DESIGN.md)",
      "Read(AGENTS.md)",
      "Read(SKILLS.md)",
      "Read(.github/instructions/**)",
      "Read(.github/copilot/**)",
      "Read(.claude/patterns/**)",
      "Read(.claude/hooks/**)",
      "Read(backend-graphql/src/schema.graphql)",
      "Read(.claude/about-me.md)",
      "Read(.claude/settings.json)",
      "Edit(**/.instructions.md)",
      "Edit(.github/copilot/**)",
      "Edit(DESIGN.md)",
      "Edit(CLAUDE.md)",
      "Edit(AGENTS.md)",
      "Bash(graphify query *)",
      "Bash(graphify path *)",
      "Bash(graphify explain *)",
      "Bash(graphify affected *)",
      "Bash(graphify update *)",
      "Bash(code-review-graph query *)",
      "Bash(code-review-graph impact *)",
      "Bash(code-review-graph detect-changes *)",
      "Bash(code-review-graph update *)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(sudo *)",
      "Bash(passwd *)",
      "Bash(chmod 000 *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/claude-pre-bash.sh",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/graph-review-advisory.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/code-review-graph-update.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/code-review-graph-status.sh",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "agentRoles": {
    "description": "Project-level Claude Code subagents (Issue #343). Format is Markdown+YAML-frontmatter under .claude/agents/, not the .claude.yaml format originally proposed in the issue — Claude Code's Agent tool does not read *.claude.yaml.",
    "configSource": ".claude/agents/",
    "invocation": "Agent(subagent_type: \"<name>\") from Claude Code, or /agents to list — NOT via `copilot @<role>` (that's GitHub Copilot CLI, see toolIsolation.githubCopilotCLI below and AGENTS.md)",
    "roles": {
      "architect": { "model": "inherits session default", "rationale": "strategic decisions need the strongest available reasoning; low volume, so default model is affordable" },
      "developer": { "model": "haiku", "rationale": "high-volume implementation with clear requirements; speed/cost over depth" },
      "code-reviewer": { "model": "haiku", "rationale": "pattern-compliance checks are largely deterministic; high PR throughput" }
    }
  },
  "toolIsolation": {
    "claudeCodeCLI": {
      "owns": [
        "Deep reasoning tasks",
        "Multi-file refactoring",
        "Test-driven development",
        "Pattern implementation"
      ],
      "reads": ["CLAUDE.md", "DESIGN.md", ".claude/patterns/"],
      "configSource": ".claude/settings.json"
    },
    "githubCopilotIDE": {
      "owns": [
        "Real-time code completion",
        "Inline explanations",
        "Quick documentation lookups"
      ],
      "reads": ["DESIGN.md", ".claude/patterns/"],
      "configSource": ".github/copilot/settings.json"
    },
    "githubCopilotCLI": {
      "owns": [
        "Planning and orchestration",
        "Cross-layer coordination",
        "PR feedback"
      ],
      "reads": ["CLAUDE.md", "DESIGN.md", "AGENTS.md", ".github/copilot/rules/"],
      "configSource": ".github/copilot/settings.json"
    }
  }
}
